# Copia questo file in .env e compila i valori. .env NON va mai committato.
# Le credenziali si ottengono da un account demo OANDA (gratuito):
#   https://www.oanda.com  ->  Manage API Access  ->  Generate token

OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# practice = conto demo (default, sempre qui finché non si va live)
# live     = conto reale (solo dopo paper trading coerente, vedi CLAUDE.md §5)
OANDA_ENV=practice
