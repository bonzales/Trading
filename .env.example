# Copia questo file in .env e compila i valori. .env NON va mai committato.
#
# Interactive Brokers NON usa un token: l'API parla con un processo ponte
# (IB Gateway o TWS) che fa il login e apre una porta locale. Devi quindi:
#   1. aprire un conto IBKR (anche senza versare fondi) e attivare il paper trading;
#   2. installare e avviare IB Gateway, loggandoti col conto PAPER;
#   3. in Gateway: Configure -> API -> Settings -> abilita "ActiveX and Socket
#      Clients" e annota la Socket port (paper: 4002).
#
# Il numero del conto paper (di solito inizia con "DU") lo vedi nella finestra
# Account di Gateway/TWS.

IBKR_ACCOUNT_ID=

# practice = conto demo/paper (default). live = conto reale (solo dopo paper
# coerente, vedi CLAUDE.md §5). Determina la porta di default se IBKR_PORT è vuota.
IBKR_ENV=practice

# Host/porta del ponte. Default: Gateway locale.
#   IB Gateway: paper 4002, live 4001 | TWS: paper 7497, live 7496
# Se il Gateway gira sul VPS, metti qui l'host raggiungibile (es. via tunnel SSH).
IBKR_HOST=127.0.0.1
IBKR_PORT=4002

# Id client della connessione API: un intero qualsiasi, univoco per connessione.
IBKR_CLIENT_ID=1
